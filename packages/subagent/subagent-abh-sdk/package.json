{
  "name": "@agentbrain-harness/subagent-abh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child agentBrain Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/subagent/subagent-abh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/sdk-client": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/subagent": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/cordis-plugin-loader": "workspace:^",
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/loader-smoke": "workspace:^",
    "@agentbrain-harness/sdk-client": "workspace:^",
    "@agentbrain-harness/sdk-protocol": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/subagent": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
