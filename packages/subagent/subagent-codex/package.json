{
  "name": "@agentbrain-harness/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.0-rc.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "abh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/subagent": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/sdk-protocol": "workspace:^",
    "@agentbrain-harness/schemastery": "workspace:^",
    "@openai/codex": "0.147.0"
  },
  "devDependencies": {
    "@agentbrain-harness/cordis-plugin-loader": "workspace:^",
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/loader-smoke": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/subagent": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/subprocess-local": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
