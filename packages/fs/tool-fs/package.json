{
  "name": "@agentbrain-harness/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the agentBrain Harness filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@agentbrain-harness/attachment": "workspace:^",
    "@agentbrain-harness/fs": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/sandbox": "workspace:^",
    "@agentbrain-harness/sandbox-policy": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/user-approval": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/agent-loop": "workspace:^",
    "@agentbrain-harness/agent-loop-testkit": "workspace:^",
    "@agentbrain-harness/attachment": "workspace:^",
    "@agentbrain-harness/fs": "workspace:^",
    "@agentbrain-harness/fs-local": "workspace:^",
    "@agentbrain-harness/fs-observation-policy": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/llm-deepseek": "workspace:^",
    "@agentbrain-harness/sandbox": "workspace:^",
    "@agentbrain-harness/sandbox-policy": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/user-approval": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
