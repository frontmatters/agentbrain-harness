{
  "name": "@agentbrain-harness/tool-lsp",
  "description": "Model-facing lsp tool over the agentBrain Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/lsp": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/fs-local": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/lsp": "workspace:^",
    "@agentbrain-harness/lsp-stdio": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/subprocess-local": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/tool-call-timeout-policy": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
