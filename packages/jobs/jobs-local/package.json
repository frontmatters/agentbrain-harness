{
  "name": "@agentbrain-harness/jobs-local",
  "description": "Process-local implementation of the agentBrain Harness background job registry seam",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/scope": "workspace:^",
    "@agentbrain-harness/jobs": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/cordis-plugin-include": "workspace:^",
    "@agentbrain-harness/cordis-plugin-loader": "workspace:^",
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/brand": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/scope": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/jobs": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
