{
  "name": "@agentbrain-harness/pwsh-local",
  "description": "Local PowerShell implementation of the agentBrain Harness bash executor seam",
  "version": "0.1.0-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentbrain-harness/shell": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^",
    "@agentbrain-harness/settings": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/shell": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/subprocess": "workspace:^",
    "@agentbrain-harness/subprocess-local": "workspace:^",
    "@agentbrain-harness/timeout": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^",
    "@agentbrain-harness/settings": "workspace:^"
  }
}
