{
  "name": "@agentbrain-harness/tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.10",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmatters/agentbrain-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/shell": "workspace:^",
    "@agentbrain-harness/shell-env": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/sandbox": "workspace:^",
    "@agentbrain-harness/sandbox-policy": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/jobs": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/user-approval": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@agentbrain-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@agentbrain-harness/agent": "workspace:^",
    "@agentbrain-harness/agent-loop": "workspace:^",
    "@agentbrain-harness/agent-loop-testkit": "workspace:^",
    "@agentbrain-harness/shell": "workspace:^",
    "@agentbrain-harness/shell-env": "workspace:^",
    "@agentbrain-harness/bash-local": "workspace:^",
    "@agentbrain-harness/invariants": "workspace:^",
    "@agentbrain-harness/llm": "workspace:^",
    "@agentbrain-harness/subprocess-local": "workspace:^",
    "@agentbrain-harness/sandbox": "workspace:^",
    "@agentbrain-harness/sandbox-policy": "workspace:^",
    "@agentbrain-harness/session": "workspace:^",
    "@agentbrain-harness/session-persistence-jsonl": "workspace:^",
    "@agentbrain-harness/system-prompt": "workspace:^",
    "@agentbrain-harness/jobs": "workspace:^",
    "@agentbrain-harness/jobs-local": "workspace:^",
    "@agentbrain-harness/tool-jobs": "workspace:^",
    "@agentbrain-harness/tools": "workspace:^",
    "@agentbrain-harness/user-approval": "workspace:^",
    "@agentbrain-harness/cordis": "workspace:^"
  }
}
